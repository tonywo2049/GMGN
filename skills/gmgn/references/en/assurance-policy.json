{
  "schema_version": "gmgn.assurance-policy.v2",
  "policy_id": "gmgn-assurance-v2",
  "reviewer": {
    "required_for": [
      "implementation-diff",
      "test-code-diff"
    ],
    "execution": "deterministic-local",
    "candidate_integrity": "reviewed-content-unchanged"
  },
  "verifier": {
    "default": false,
    "candidate": "blocker-resolved-final",
    "classification": {
      "not_required": "not-required",
      "required_prefix": "required:"
    },
    "triggers": [
      "artifact-not-fully-machine-checkable",
      "reviewer-unavailable-real-startup-or-e2e",
      "explicit-independent-execution-requirement"
    ]
  }
}
